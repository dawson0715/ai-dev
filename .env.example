MONGO_URL=mongodb://localhost:27017/agent
CLICKUP_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
POLL_INTERVAL_MS=30000
# Numero massimo di job eseguiti insieme. MongoDB limita comunque a uno per progetto.
WORKER_CONCURRENCY=4
# Heartbeat del worker e timeout dopo il quale l'API recupera un job running orfano.
JOB_HEARTBEAT_MS=30000
RUNNING_JOB_STALE_MS=3600000
# Mappa JSON { nome_service_account: "<user>:<password>" } usata da API e worker.
# L'API espone alla web UI soltanto i nomi, per popolare il menu dei progetti.
# Il nome è il path del gruppo top-level salvato in projects.gitlab.service_account.
# Senza ":" il valore è trattato come token (username "oauth2").
GITLAB_SERVICE_ACCOUNTS={"my-group":"service-account-user:glpat-xxxxxxxxxxxxxxxxxxxx"}
